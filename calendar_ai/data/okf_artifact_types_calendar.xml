<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Artefakttyp för calendar_ai (okf-mixin D12). -->
    <record id="artifact_type_event" model="ai.artifact.type">
        <field name="name">event</field>
        <field name="kind">knowledge</field>
        <field name="bridge_module">calendar_ai</field>
        <field name="model_id" ref="calendar.model_calendar_event"/>
        <field name="okf_contract" eval="{'generated_by': 'process', 'stale_policy': 'source', 'stale_ttl_days': 0, 'retention_purpose': 'none', 'retention_days': 0}"/>
    </record>
</odoo>

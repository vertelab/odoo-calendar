    <record id="slide_cal_s1_04_q1" model="slide.question">
        <field name="question">Vad synkroniserar CardDAV?</field>
        <field name="sequence">1</field>
        <field name="slide_id" ref="slide_cal_s1_04"/>
    </record>
    <record id="slide_cal_s1_04_q1_a1" model="slide.answer">
        <field name="text_value">Kalenderhändelser och möten</field>
        <field name="sequence">1</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Inte riktigt — det är CalDAV. C:et i CardDAV står för vCard.</field>
        <field name="question_id" ref="slide_cal_s1_04_q1"/>
    </record>
    <record id="slide_cal_s1_04_q1_a2" model="slide.answer">
        <field name="text_value">Kontaktuppgifter — namn, telefon, e-post</field>
        <field name="sequence">2</field>
        <field name="is_correct" eval="True"/>
        <field name="comment">Rätt! CardDAV synkroniserar kontakter i vCard-format (RFC 6352).</field>
        <field name="question_id" ref="slide_cal_s1_04_q1"/>
    </record>
    <record id="slide_cal_s1_04_q1_a3" model="slide.answer">
        <field name="text_value">E-postmeddelanden och bilagor</field>
        <field name="sequence">3</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Nej — e-post hanteras av IMAP/SMTP, inte DAV.</field>
        <field name="question_id" ref="slide_cal_s1_04_q1"/>
    </record>

    <record id="slide_cal_s1_04_q2" model="slide.question">

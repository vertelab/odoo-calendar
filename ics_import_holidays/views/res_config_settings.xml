<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ics_import_holidays</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="40"/>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app/div[@id='invite_users']" position="after">
                <div id="ics_import_holidays">
                    <block title="Holiday import" name="ics_import_holidays_container">
                        <setting id="ics_url_setting" help="One .ics file. The events are imported into the calendar and into every working schedule.">
                            <label for="ics_url" string="ICS URL"/>
                            <field name="ics_url" placeholder="https://.../holidays.ics"/>
                        </setting>
                    </block>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
